{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "preserve",
    "checkJs": false,
    "allowJs": true
  },
  "include": [
    "next.config.js",
    "server.js",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".vercel",
    ".idx",
    ".agents",
    ".claude",
    ".obsidian",
    "engines_backup",
    "scratch",
    "docs",
    "public/games/**/vendor/**",
    "public/games/**/assets/**",
    "public/games/**/draco/**",
    "public/games/**/basis/**",
    "public/games/**/game_assets/**",
    "public/games/**/immutable/**"
  ]
}
